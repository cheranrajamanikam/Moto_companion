# Supabase — optional. Leave as placeholders (or omit .env) to run in Demo Mode.
# Demo Mode uses mock auth + local demo data — no external services required.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Alternative key name (Cheran base project):
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# AI Riding Companion — required for real AI responses (falls back to mock if missing)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional — if using a custom AI backend handler
VITE_AI_HANDLER_URL=http://localhost:3001/api/rider-ai
